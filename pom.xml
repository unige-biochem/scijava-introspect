<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.scijava</groupId>
		<artifactId>pom-scijava</artifactId>
		<version>45.1.0</version>
		<relativePath />
	</parent>

	<groupId>ch.unige.biochem</groupId>
	<artifactId>scijava-introspect</artifactId>
	<version>0.1.0-SNAPSHOT</version>

	<name>SciJava Introspect</name>
	<description>A CLI for introspecting SciJava/ImageJ2 commands, used to build MCP servers and documentation for Fiji</description>
	<url>https://github.com/unige-biochem/scijava-introspect</url>
	<inceptionYear>2026</inceptionYear>
	<organization>
		<name>University of Geneva, Department of Biochemistry</name>
		<url>https://www.unige.ch/sciences/biochimie/</url>
	</organization>
	<licenses>
		<license>
			<name>MIT License</name>
			<url>https://opensource.org/licenses/MIT</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<developer>
			<id>nicokiaru</id>
			<name>Nicolas Chiaruttini</name>
			<url>https://www.unige.ch/sciences/biochimie/</url>
			<roles>
				<role>founder</role>
				<role>lead</role>
				<role>developer</role>
				<role>debugger</role>
				<role>reviewer</role>
				<role>support</role>
				<role>maintainer</role>
			</roles>
		</developer>
	</developers>
	<contributors>
		<contributor>
			<name>Nicolas Chiaruttini</name>
			<url>https://www.unige.ch/sciences/biochimie/</url>
			<roles><role>founder</role></roles>
			<properties><id>NicoKiaru</id></properties>
		</contributor>
	</contributors>

	<mailingLists>
		<mailingList>
			<name>Image.sc Forum</name>
			<archive>https://forum.image.sc/</archive>
		</mailingList>
	</mailingLists>

	<scm>
		<connection>scm:git:https://github.com/unige-biochem/scijava-introspect</connection>
		<developerConnection>scm:git:git@github.com:unige-biochem/scijava-introspect</developerConnection>
		<tag>HEAD</tag>
		<url>https://github.com/unige-biochem/scijava-introspect</url>
	</scm>

	<issueManagement>
		<system>GitHub Issues</system>
		<url>https://github.com/unige-biochem/scijava-introspect/issues</url>
	</issueManagement>

	<ciManagement>
		<system>GitHub Actions</system>
		<url>https://github.com/unige-biochem/scijava-introspect/actions</url>
	</ciManagement>

	<properties>
		<package-name>ch.unige.biochem.scijava.introspect</package-name>
		<main-class>ch.unige.biochem.scijava.introspect.CLI</main-class>
		<license.licenseName>mit</license.licenseName>
		<license.copyrightOwners>University of Geneva, Department of Biochemistry</license.copyrightOwners>
		<reflections.version>0.10.2</reflections.version>

		<!-- NB: Deploy releases to the SciJava Maven repository. -->
		<releaseProfiles>sign,deploy-to-scijava</releaseProfiles>
	</properties>

	<repositories>
		<repository>
			<id>scijava.public</id>
			<url>https://maven.scijava.org/content/groups/public</url>
		</repository>
	</repositories>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<source>9</source>
					<target>9</target>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<dependencies>

		<!-- Command, Plugin, Parameter, Context, Service, Button -->
		<dependency>
			<groupId>org.scijava</groupId>
			<artifactId>scijava-common</artifactId>
		</dependency>

		<!-- SourceFinder, for the source-code subcommand -->
		<dependency>
			<groupId>org.scijava</groupId>
			<artifactId>scijava-search</artifactId>
		</dependency>

		<!-- JSON output. Also reachable transitively, but named here because this is
		     the format every subcommand but `tree` emits. -->
		<dependency>
			<groupId>com.google.code.gson</groupId>
			<artifactId>gson</artifactId>
		</dependency>

		<dependency>
			<groupId>org.reflections</groupId>
			<artifactId>reflections</artifactId>
			<version>${reflections.version}</version>
		</dependency>

		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>
</project>
